# SecureTrade settings. Copy this file to .env and fill in the values.
# NEVER commit .env, and never paste its values into a chat or a screenshot.

# --- Required ---
DATABASE_URL=                 # Supabase: Project Settings > Database > Connection string (pooler)
JWT_SECRET=                   # a random text of at least 32 characters; a different one on each host
                              #   make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
                              # Changing it signs everyone out, and admins must set up two-step sign-in again
                              #   (run: node scripts/reset-admin-2fa.js <admin email>, then sign in and scan a new QR code)

# --- The site's own address ---
PUBLIC_URL=                   # for example https://your-app.up.railway.app (no slash at the end)
NODE_ENV=                     # "production" on a host; leave empty on your own computer
TRUST_PROXY=                  # "1" on Railway or Render; leave empty on your own computer
PORT=                         # the host usually sets this itself

# --- Email (sign-up PINs and trade updates) ---
MAIL_FROM=                    # the sender address, verified in Brevo
BREVO_API_KEY=                # on a host: Brevo > SMTP & API > API Keys (starts with xkeysib-)
SMTP_HOST=                    # on your own computer instead: smtp-relay.brevo.com
SMTP_PORT=                    # 587
SMTP_USER=
SMTP_KEY=                     # Brevo SMTP key (starts with xsmtpsib-)
DEV_LOG_PIN=                  # "true" prints PINs in the server log when email is off. Never in production.

# --- Payments (Xendit) ---
XENDIT_SECRET_KEY=            # a TEST key (xnd_development_...). Live keys are refused unless XENDIT_ALLOW_LIVE=true
XENDIT_WEBHOOK_TOKEN=         # Xendit > Settings > Webhooks > verification token
XENDIT_ALLOW_LIVE=            # leave empty until refunds and payouts move real money
QR_PAYMENTS=                  # "on" to offer QR Ph (it cannot be refunded automatically)
ALLOW_SIMULATED_PAYMENTS=     # "true" only on your own computer without Xendit keys. Refused in production.

# --- Uploaded pictures ---
SUPABASE_URL=                 # https://<project-id>.supabase.co ; leave empty to keep files on this computer
SUPABASE_SERVICE_KEY=         # the secret key (sb_secret_...) or the legacy service_role key (eyJ...)
SUPABASE_BUCKET=              # default: uploads (a PRIVATE bucket)

# --- Optional ---
IDLE_MINUTES=                 # signed out after this many minutes without activity (default 15)
CORS_ORIGINS=                 # other sites allowed to call the API, comma-separated
FRONTEND_URL=                 # only when the pages are served from a different address than the API
